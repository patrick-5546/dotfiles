#!/bin/bash

printf "\n# Check Prerequisites\n"
check_installed() {
    if command -v $1 &>/dev/null; then
        printf "# $1 is installed at\t\t$(which $1)\n"
    else
        printf "# $1 is NOT installed\n"
        exit 1
    fi
}
check_installed curl
check_installed nvim
check_installed tmux
check_installed zsh

pushd ~
printf "\n# Install/update Chezmoi\n"
sh -c "$(curl -fsLS get.chezmoi.io)"

printf "\n# Install/update GRM\n"
BINARY=grm_{{.chezmoi.os}}_{{.chezmoi.arch}}.tar.gz
curl -s https://api.github.com/repos/jsnjack/grm/releases/latest \
  | awk -F'"' '/"browser_download_url":/{print $4}' | grep $BINARY \
  | xargs curl -LOs && tar -xf $BINARY && rm $BINARY && mv grm $HOME/bin/
echo "info found version $($HOME/bin/grm version) for latest/{{.chezmoi.os}}/{{.chezmoi.arch}}"
echo "info installed bin/grm"
$HOME/bin/grm set bin_dir $HOME/bin
popd

printf "\n# Install/update GRM dotfile dependencies\n"
# grm remembers each package's filters and selected binaries. Changing a -f
# filter or passing --asset or --binary makes it select and reinstall again.
# With --yes grm installs the first asset matching every -f filter, and gnu
# builds are listed before musl ones. Filter on the full Rust target so Linux
# gets the static musl build, which also runs on older glibc. A filter that
# matches nothing is ignored, so tools without that build still install. lsd
# uses gnu because its musl build shows uid/gid instead of user/group names.
{{- $arch := .chezmoi.arch | replace "amd64" "x86_64" | replace "arm64" "aarch64" }}
{{- $target := printf "%s-apple-darwin" $arch }}
{{- $gnuTarget := $target }}
{{- if eq .chezmoi.os "linux" }}
{{-   $target = printf "%s-unknown-linux-musl" $arch }}
{{-   $gnuTarget = printf "%s-unknown-linux-gnu" $arch }}
{{- end }}
#$HOME/bin/grm install --yes -f tar.gz atuinsh/atuin
$HOME/bin/grm install --yes -f tar.gz -f {{ $target }} sharkdp/bat
$HOME/bin/grm install --yes -f tar.gz -f {{ $target }} dandavison/delta
$HOME/bin/grm install --yes -f tar.gz -f {{ $target }} bootandy/dust
$HOME/bin/grm install --yes -f tar.gz -f {{ $target }} sharkdp/fd
$HOME/bin/grm install --yes -f tar.gz junegunn/fzf
$HOME/bin/grm install --yes -f tar.gz jesseduffield/lazygit
$HOME/bin/grm install --yes -f tar.gz -f {{ $gnuTarget }} lsd-rs/lsd
$HOME/bin/grm install --yes -f tar.gz -f {{ $target }} BurntSushi/ripgrep
$HOME/bin/grm install --yes -f tar.gz -f {{ $target }} starship/starship
$HOME/bin/grm install --yes -f zip -f {{ $target }} sxyazi/yazi
$HOME/bin/grm install --yes -f tar.gz -f {{ $target }} ajeetdsouza/zoxide

printf "\n# Install/update completions\n"
mkdir -p $HOME/.config/zsh/completions
pushd $HOME/.config/zsh/completions
#$HOME/bin/atuin gen-completions --shell zsh -o .
$HOME/bin/bat --completion zsh >> _bat  # doesn't work
$HOME/bin/chezmoi completion zsh >> _chezmoi
$HOME/bin/delta --generate-completion zsh >> _delta  # needs to be sourced manually
curl -o _dust https://raw.githubusercontent.com/bootandy/dust/master/completions/_dust
curl -o _fd https://raw.githubusercontent.com/sharkdp/fd/master/contrib/completion/_fd
$HOME/bin/fzf --zsh >> _fzf  # doesn't work
$HOME/bin/grm completion zsh >> _grm  # needs to be sourced manually
# could not find zsh completion for lsd
$HOME/bin/rg --generate=complete-zsh >> _rg
$HOME/bin/starship completions zsh >> _starship
curl -o _zoxide https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/contrib/completions/_zoxide
popd

{{ if or (eq .chezmoi.os "darwin") (not (.chezmoi.kernel.osrelease | lower | contains "microsoft")) -}}
{{ if eq .chezmoi.os "linux" -}}
{{ if eq .chezmoi.osRelease.id "fedora" -}}
printf "\n# Install dnf utilities\n"
sudo dnf -y update && sudo dnf -y install \
    fontconfig \
    unzip \
    util-linux-user \
{{- end -}}

if [ ! -d ~/.local/share/fonts/FiraCode ]
then
    printf "\n# Install fonts\n"
    mkdir -p ~/.local/share/fonts/FiraCode
    curl -L https://github.com/ryanoasis/nerd-fonts/releases/latest/download/FiraCode.zip --output FiraCode.zip
    unzip FiraCode.zip -d ~/.local/share/fonts/FiraCode "Fira*Mono*.ttf"
    rm FiraCode.zip
    fc-cache -f
else
    printf "\n# Fonts already installed\n"
fi
{{ end }}
{{- end -}}

printf "\n# Checking GitHub account status\n"
$HOME/bin/grm install --yes{{ if eq .chezmoi.os "linux" }} -f tar.gz{{ end }} cli/cli
gh auth status
if [ $? -ne 0 ]
then
    gh auth login
fi

if [ $(basename $SHELL) != "zsh" ]
then
    printf "\n# Make Zsh default shell\n"
    command -v zsh | sudo tee -a /etc/shells
    chsh -s $(which zsh)
else
    printf "\n# Zsh already default shell\n"
fi

printf "\n# Script finished successfully, open a new terminal to use new configuration\n"
