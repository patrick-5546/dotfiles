#!/bin/bash

printf "\n# Check Prerequisites\n"
check_installed() {
    if command -v $1 &>/dev/null; then
        printf "# $1 is installed at\t\t$(which $1)\n"
    else
        printf "# $1 is NOT installed\n"
        exit 1
    fi
}
check_installed nvim
check_installed tmux

pushd ~
printf "\n# Install/update Chezmoi\n"
sh -c "$(curl -fsLS get.chezmoi.io/lb)"

printf "\n# Install/update GRM\n"
BINARY=grm_{{.chezmoi.os}}_{{.chezmoi.arch}}.tar.gz
curl -s https://api.github.com/repos/jsnjack/grm/releases/latest \
  | awk -F'"' '/"browser_download_url":/{print $4}' | grep $BINARY \
  | xargs curl -LOs && tar -xf $BINARY && rm $BINARY && mv grm $HOME/.local/bin/
echo "info found version $($HOME/.local/bin/grm version) for latest/{{.chezmoi.os}}/{{.chezmoi.arch}}"
echo "info installed .local/bin/grm"
$HOME/.local/bin/grm set bin_dir $HOME/.local/bin
popd

printf "\n# Install/update GRM dotfile dependencies\n"
# grm remembers each package's filters and selected binaries. Changing a -f
# filter or passing --asset or --binary makes it select and reinstall again.
# With --yes grm installs the first asset matching every -f filter, and gnu
# builds are listed before musl ones. Filter on the full Rust target so Linux
# gets the static musl build, which also runs on older glibc. A filter that
# matches nothing is ignored, so tools without that build still install. lsd
# uses gnu because its musl build shows uid/gid instead of user/group names.
{{- $arch := .chezmoi.arch | replace "amd64" "x86_64" | replace "arm64" "aarch64" }}
{{- $target := printf "%s-apple-darwin" $arch }}
{{- $gnuTarget := $target }}
{{- if eq .chezmoi.os "linux" }}
{{-   $target = printf "%s-unknown-linux-musl" $arch }}
{{-   $gnuTarget = printf "%s-unknown-linux-gnu" $arch }}
{{- end }}
$HOME/.local/bin/grm install --yes -f tar.gz -f atuin-{{ $target }} atuinsh/atuin  # atuin- skips atuin-server
$HOME/.local/bin/grm install --yes -f tar.gz -f {{ $target }} sharkdp/bat
$HOME/.local/bin/grm install --yes -f tar.gz -f {{ $target }} dandavison/delta
$HOME/.local/bin/grm install --yes -f tar.gz -f {{ $target }} bootandy/dust
$HOME/.local/bin/grm install --yes -f tar.gz -f {{ $target }} sharkdp/fd
$HOME/.local/bin/grm install --yes -f tar.gz junegunn/fzf
$HOME/.local/bin/grm install --yes -f tar.gz jesseduffield/lazygit
$HOME/.local/bin/grm install --yes -f tar.gz -f {{ $gnuTarget }} lsd-rs/lsd
$HOME/.local/bin/grm install --yes -f tar.gz -f {{ $target }} BurntSushi/ripgrep
$HOME/.local/bin/grm install --yes -f tar.gz -f {{ $target }} starship/starship
$HOME/.local/bin/grm install --yes -f tar.gz -f {{ $target }} astral-sh/uv
# Remove the standalone installer's receipt so uv self update can't replace grm's uv
rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/uv/uv-receipt.json"
$HOME/.local/bin/grm install --yes -f zip -f {{ $target }} sxyazi/yazi
$HOME/.local/bin/grm install --yes -f tar.gz -f {{ $target }} ajeetdsouza/zoxide

printf "\n# Install/update completions\n"
mkdir -p $HOME/.config/zsh/completions
pushd $HOME/.config/zsh/completions
$HOME/.local/bin/atuin gen-completions --shell zsh -o .
$HOME/.local/bin/bat --completion zsh >> _bat  # doesn't work
$HOME/.local/bin/chezmoi completion zsh >> _chezmoi
$HOME/.local/bin/delta --generate-completion zsh >> _delta  # needs to be sourced manually
curl -o _dust https://raw.githubusercontent.com/bootandy/dust/master/completions/_dust
curl -o _fd https://raw.githubusercontent.com/sharkdp/fd/master/contrib/completion/_fd
rm -f _fzf  # fzf --zsh output, which .zshrc now sources directly
$HOME/.local/bin/grm completion zsh >> _grm  # needs to be sourced manually
# could not find zsh completion for lsd
$HOME/.local/bin/rg --generate=complete-zsh >> _rg
$HOME/.local/bin/starship completions zsh >> _starship
$HOME/.local/bin/uv generate-shell-completion zsh > _uv
$HOME/.local/bin/uvx --generate-shell-completion zsh > _uvx
curl -o _zoxide https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/contrib/completions/_zoxide
popd

printf "\n# Checking GitHub account status\n"
$HOME/.local/bin/grm install --yes{{ if eq .chezmoi.os "linux" }} -f tar.gz{{ end }} cli/cli
gh auth status
if [ $? -ne 0 ]
then
    gh auth login
fi

printf "\n# Script finished successfully, open a new terminal to use new configuration\n"
