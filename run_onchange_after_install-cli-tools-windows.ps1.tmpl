# Installs mise (https://mise.jdx.dev) and the tools in ~/.config/mise/config.toml.
# chezmoi runs this after applying files and again whenever this script, the
# mise config or mise.lock changes.
# mise config hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
# mise.lock hash: {{ include "dot_config/mise/mise.lock" | sha256sum }}
$ErrorActionPreference = 'Stop'

$mise = "$HOME\.local\bin\mise.exe"
$version = {{ (include "dot_config/mise/config.toml" | fromToml).min_version | squote }}
if (-not (Test-Path $mise -PathType Leaf)) {
    Write-Host "`n# Install mise"
    # The installer also adds ~\.local\bin to the user Path
    $env:MISE_INSTALL_PATH = $mise
    $env:MISE_VERSION = $version
    Invoke-RestMethod https://mise.run/powershell | Invoke-Expression
} elseif ([version]((& $mise --version) -split ' ')[0] -lt [version]$version) {
    Write-Host "`n# Update mise to $version, the config's min_version"
    & $mise self-update --yes $version
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
}

Write-Host "`n# Install tools with mise"
# Only the versions in mise.lock, and fail if it doesn't have them
& $mise install --locked
if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }

# git gets GitHub credentials from gh (see ~/.config/git/config). Skipped when
# chezmoi's input isn't the terminal, as in CI
if (-not [Console]::IsInputRedirected) {
    & $mise exec -- gh auth status *> $null
    if ($LASTEXITCODE -ne 0) {
        Write-Host "`n# Log in to GitHub"
        & $mise exec -- gh auth login
        if ($LASTEXITCODE -ne 0) { Write-Warning 'gh auth login failed, run it again later' }
    }
}
