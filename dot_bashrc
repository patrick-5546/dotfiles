# Functions
source "$HOME/.config/zsh/functions.zsh"

# Aliases
source "$HOME/.config/zsh/aliases.zsh"

# Tools installed by mise: https://mise.jdx.dev
eval "$("$HOME/bin/mise" activate bash)"

# Pixi: https://github.com/prefix-dev/pixi
command -v pixi >/dev/null && eval "$(pixi completion --shell bash)"

# Zoxide: https://github.com/ajeetdsouza/zoxide
eval "$(zoxide init bash)"

# fzf configuration
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --info=inline'
export FZF_DEFAULT_COMMAND="fd --hidden --follow --exclude '.git'"
export FZF_ALT_C_COMMAND="$FZF_DEFAULT_COMMAND --type d"

# Use fd for fzf path/dir completion
_fzf_compgen_path() {
  fd --hidden --follow --exclude ".git" . "$1"
}
_fzf_compgen_dir() {
  fd --type d --hidden --follow --exclude ".git" . "$1"
}

# Key bindings and ** completion. The empty FZF_CTRL_T_COMMAND skips the file
# widget, which conflicts with the Copilot CLI file picker.
FZF_CTRL_T_COMMAND='' eval "$(fzf --bash)"

[[ "$TERM_PROGRAM" == "vscode" ]] && source "$(code --locate-shell-integration-path bash)"
