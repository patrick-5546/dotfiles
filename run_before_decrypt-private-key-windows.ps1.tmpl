if (-Not (Test-Path "{{ .chezmoi.homeDir }}/.chezmoikey.txt" -PathType Leaf)) {
    Write-Host "# create ~/.chezmoikey.txt"
    & "{{ .chezmoi.executable }}" age decrypt --output "{{ .chezmoi.homeDir }}/.chezmoikey.txt" --passphrase "{{ .chezmoi.sourceDir }}/key.txt.age"
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
}
