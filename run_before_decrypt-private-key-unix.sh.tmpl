#!/bin/sh
set -eu

if [ ! -f "{{ .chezmoi.homeDir }}/.chezmoikey.txt" ]; then
    printf "# create ~/.chezmoikey.txt\n"
    "{{ .chezmoi.executable }}" age decrypt --output "{{ .chezmoi.homeDir }}/.chezmoikey.txt" --passphrase "{{ .chezmoi.sourceDir }}/key.txt.age"
    chmod 600 "{{ .chezmoi.homeDir }}/.chezmoikey.txt"
fi
