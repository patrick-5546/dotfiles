# Tools installed by run_onchange_after_install-tools-unix.sh.
# Update them with `mise upgrade`. See https://mise.jdx.dev/configuration.html
[tools]
# On Linux, the glibc builds of atuin and yazi need glibc 2.39 (Ubuntu 24.04),
# so use their static musl builds. mise uses glibc builds for the other tools,
# which matters for lsd: its musl build shows uid/gid instead of user names.
atuin = { version = "latest", libc = "musl" }
bat = "latest"
copilot = "latest"
delta = "latest"
dust = "latest"
fd = "latest"
fzf = "latest"
gh = "latest"
{{ if not .work -}}
go = "latest"
{{ end -}}
lazygit = "latest"
lsd = "latest"
neovim = "latest"
node = "lts"
ripgrep = "latest"
starship = "latest"
tmux = "latest"
uv = "latest"
yazi = { version = "latest", libc = "musl" }
zoxide = "latest"
