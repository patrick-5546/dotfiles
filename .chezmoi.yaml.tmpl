{{- $encryption := promptBoolOnce . "encryption" "Decrypt the encrypted files with the key passphrase" true -}}
{{- $apps := false -}}
{{- if ne .chezmoi.os "linux" -}}
{{-   $apps = promptBoolOnce . "apps" "Install the desktop apps" true -}}
{{- end -}}
{{ if eq .chezmoi.os "windows" -}}
cd:
    command: "pwsh"
    args: ["-NoLogo", "-NoExit", "-Command", "& {Set-Location $env:HOMEPATH/.local/share/chezmoi}"]
interpreters:
    ps1:
        # Skip the profile, which needs the tools that the scripts install
        command: "pwsh"
        args: ["-NoLogo", "-NoProfile"]
{{ end -}}

data:
    apps: {{ $apps }}
    encryption: {{ $encryption }}
diff:
    pager: "delta"
edit:
    command: "nvim"
encryption: "age"
age:
    identity: "{{ .chezmoi.homeDir }}/.chezmoikey.txt"
    recipient: "age1tqerfm7h83nl3d6ewcmhze8jmndfaaznrt84e8r0cd9rux9l5cwq72c992"
