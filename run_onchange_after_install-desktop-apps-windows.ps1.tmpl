# Installs the desktop apps with winget, skipping the ones that are already
# installed. chezmoi runs this after applying files, and again whenever this
# script changes, or until every app installs. Some of the installers ask for
# administrator rights.
$ErrorActionPreference = 'Stop'

# The apps' names, winget IDs and the sources they're from, from
# .chezmoidata/desktop-apps.toml
$apps = @(
{{- range .desktopApps }}
{{-   if hasKey . "winget" }}
    @{ Name = {{ squote .name }}; Id = {{ squote .winget }}; Source = 'winget' }
{{-   else if hasKey . "msstore" }}
    @{ Name = {{ squote .name }}; Id = {{ squote .msstore }}; Source = 'msstore' }
{{-   end }}
{{- end }}
)
$failed = @()
foreach ($app in $apps) {
    Write-Host "`n# Install $($app.Name) with winget"
    winget install --exact --id $app.Id --source $app.Source --no-upgrade --accept-package-agreements --accept-source-agreements
    # -1978335135 means it's already installed
    if ($LASTEXITCODE -ne 0 -and $LASTEXITCODE -ne -1978335135) { $failed += $app.Name }
}
if ($failed) {
    throw "winget couldn't install $($failed -join ', '). Run chezmoi apply to try again"
}
